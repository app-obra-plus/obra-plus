
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())@db.Uuid
  email             String    @unique
  password          String
  first_name        String
  last_name         String
  phone_number       String
  profile_picture   String?
  isDeleted      Boolean @default(false) @map("is_deleted")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  addresses       Address[]
  advertisements    Advertisement[]

  @@map("tb_user")
}

model Address {
  id           String   @id @default(uuid())@db.Uuid 
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  postal_code  String
  country      String
  latitude     Float
  longitude    Float
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user_id      String  @db.Uuid  
  isDeleted      Boolean @default(false) @map("is_deleted")
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("tb_addresses")
}

model AdvertisementAddress {
  id           String   @id @default(uuid()) @db.Uuid
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  postal_code  String
  country      String
  latitude     Float
  longitude    Float
  isDeleted    Boolean @default(false) @map("is_deleted")
  advertisement Advertisement[]

  
  @@map("tb_advertisement_addresses")
}

enum AdvertisementStatus {
  ACTIVE
  SOLD
  PAUSED
}

enum UnitOfMeasure {
  UNIT
  KG 
  LITER
  METER
}

model Advertisement {
  id             String   @id @default(uuid()) @db.Uuid
  title          String
  description    String
  price          Float
  status         AdvertisementStatus @default(ACTIVE)
  isDonation     Boolean  @map("is_donation")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  amount         Float
  unitOfMeasure  UnitOfMeasure @map("unit_of_measure")
  isDeleted      Boolean @default(false) @map("is_deleted")
  user_id        String   @db.Uuid
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category_id    String      @db.Uuid
  category       Category    @relation(fields: [category_id], references: [id])

  advertisementAddressId String      @db.Uuid  @map("advertisement_address_id")
  advertisementAddress  AdvertisementAddress @relation(fields: [advertisementAddressId], references: [id])
  
  images         Image[]

  @@map("tb_advertisements")
}

model Image {
  id                 String         @id @default(uuid()) @db.Uuid
  url                String
  pathname           String
  created_at         DateTime       @default(now())

  advertisement_id   String         @db.Uuid
  advertisement      Advertisement  @relation(fields: [advertisement_id], references: [id], onDelete: Cascade)

  @@map("tb_images")
}

model Category{
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  description         String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  advertisements Advertisement[]
   @@map("tb_category")
}